# Private server settings. Do not replace an existing .env.local with this template.
DATABASE_URL=postgresql://user:password@host:5432/pay
PAY_PUBLIC_URL=https://www.payroatanselfstorage.com
PAY_SESSION_TOKEN_SECRET=
# Minimum 32 characters. Used by the scheduled reconciliation worker.
CRON_SECRET=
# Optional compatibility secret for POST /api/internal/reconcile.
PAY_RETRY_SECRET=
PAY_DEMO_ENABLED=false
PAY_SANDBOX_MANUAL_ENABLED=false

# USD display; the server charges HNL using BCH indicator 97.
BCH_API_KEY=
BCH_API_URL=https://bchapi-am.azure-api.net/api/v1/indicadores/97/cifras
BCH_INDICADOR_ID=97

# sandbox chooses apitest.cybersource.com; production chooses api.cybersource.com.
# Real Storeganise + sandbox requires the explicit opt-in and test customers below.
# Set this explicitly in Vercel and redeploy; this template does not set Vercel variables.
CYBERSOURCE_ENVIRONMENT=sandbox
CYBERSOURCE_MERCHANT_ID=
CYBERSOURCE_KEY_ID=
CYBERSOURCE_SHARED_SECRET=

# Enable the customer reservation API and signed Storeganise payment notifications.
# Customer login uses the same PAY_SESSION_TOKEN_SECRET (min 32 chars) for encrypted HttpOnly cookies.
STOREGANISE_PAY_ENABLED=false
# Opt-in profile delivery bridge. Configure the read-only pay_checkout_bridge
# customer field and Storeganise connect-src before enabling. See CONEXION_GTM_STOREGANISE.md.
STOREGANISE_BRIDGE_ENABLED=false
# Permit real Storeganise data with sandbox payments, without payment/occupancy writes.
# Enable explicitly for this temporary mode. See CONEXION_GTM_STOREGANISE.md.
STOREGANISE_LIVE_SANDBOX_ENABLED=false
STOREGANISE_API_URL=https://roatanselfstorage.storeganise.com/api/v1/admin
STOREGANISE_API_KEY=
STOREGANISE_WEBHOOK_SECRET=
# Must match the code configured in Storeganise manualPaymentMethods.
STOREGANISE_CARD_PAYMENT_METHOD=card
# Complete only the ready invoice_createInitial step after its invoice is paid.
STOREGANISE_COMPLETE_PAID_INVOICE_STEP=true
# Comma-separated Storeganise customer IDs allowed to run sandbox payments.
# For live Storeganise use the actual 24-character user IDs, not emails or order IDs.
# Manual sandbox uses manual-sandbox-customer and never writes to Storeganise.
STOREGANISE_TEST_CUSTOMER_IDS=manual-sandbox-customer

# Pay does not notify the fiscal Portal directly. Storeganise owns that connection.

