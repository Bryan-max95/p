# Private server settings. Do not replace an existing .env.local with this template.
DATABASE_URL=postgresql://user:password@host:5432/pay
PAY_PUBLIC_URL=https://payroatanselfstorage.com
PAY_SESSION_TOKEN_SECRET=
# Minimum 32 characters. Used by the scheduled reconciliation worker.
CRON_SECRET=
# Optional compatibility secret for POST /api/internal/reconcile.
PAY_RETRY_SECRET=
PAY_DEMO_ENABLED=false
PAY_SANDBOX_MANUAL_ENABLED=false

# USD display; the server charges HNL using BCH indicator 97.
BCH_API_KEY=
BCH_API_URL=https://bchapi-am.azure-api.net/api/v1/indicadores/97/cifras
BCH_INDICADOR_ID=97

# Existing BAC credentials. Environment chooses apitest or api.cybersource.com.
CYBERSOURCE_ENVIRONMENT=sandbox
CYBERSOURCE_MERCHANT_ID=
CYBERSOURCE_KEY_ID=
CYBERSOURCE_SHARED_SECRET=

# Enable only after configuring the signed, server-side handoff in Storeganise.
STOREGANISE_PAY_ENABLED=false
STOREGANISE_API_URL=https://roatanselfstorage.storeganise.com/api/v1/admin
STOREGANISE_API_KEY=
STOREGANISE_WEBHOOK_SECRET=
# Must match the code configured in Storeganise manualPaymentMethods.
STOREGANISE_CARD_PAYMENT_METHOD=card
# Complete only the ready invoice_createInitial step after its invoice is paid.
STOREGANISE_COMPLETE_PAID_INVOICE_STEP=true
# Sandbox Storeganise requires a .storeganise.dev instance and its real test user IDs.
# Manual sandbox uses manual-sandbox-customer and never writes to Storeganise.
STOREGANISE_TEST_CUSTOMER_IDS=manual-sandbox-customer

# Pay does not notify the fiscal Portal directly. Storeganise owns that connection.

